# Hosted HTTP MCP (OAuth Connect on Configure — one slot per Cursor surface)
PORT=8788
ODOO_JSON2_PUBLIC_URL=https://odoo-json2.tylerjharden.dev
# Local / Docker only. On Vercel, BLOB_READ_WRITE_TOKEN wins (do not put Odoo keys here).
ODOO_JSON2_STORE=./data/store.json
# BLOB_READ_WRITE_TOKEN=
# ODOO_JSON2_BLOB_PATH=odoo-json2-oauth-store.json

# Stdio single-instance fallback only (no account list in Cursor)
# ODOO_URL=https://mycompany.odoo.com
# ODOO_API_KEY=
# ODOO_DATABASE=
